// Coleta de stdout/stderr de todos os contêineres do host pela API do Docker
// (via socket-proxy, só leitura) e envio ao Loki pelo gateway autenticado.
// Especificação: specs/003-agregacao-logs-loki/

logging {
	level  = "info"
	format = "json"
}

discovery.docker "containers" {
	host             = "tcp://socket-proxy:2375"
	refresh_interval = "1s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host             = "tcp://socket-proxy:2375"
	targets          = discovery.docker.containers.targets
	relabel_rules    = discovery.relabel.containers.rules
	refresh_interval = "1s"
	forward_to       = [loki.process.containers.receiver]
}

loki.process "containers" {
	// Mascaramento de segredos conhecidos (FR-022): só o grupo de captura é trocado.
	stage.replace {
		expression = "(?i)bearer\\s+([A-Za-z0-9._~+/=-]+)"
		replace    = "<redacted>"
	}

	stage.replace {
		expression = "\\b(sk-[A-Za-z0-9_-]{16,})"
		replace    = "<redacted>"
	}

	stage.replace {
		expression = "(?i)(?:password|passwd|pwd|secret|token|api_key|apikey)\"?\\s*[:=]\\s*\"?([^\"\\s,&}]+)"
		replace    = "<redacted>"
	}

	// Metadados estruturados (FR-007): extraídos de linhas JSON, sem virar rótulo.
	// Linhas que não são JSON passam intactas, só sem os metadados (FR-008).
	stage.json {
		expressions = {
			level    = "",
			trace_id = "",
			span_id  = "",
		}
	}

	stage.structured_metadata {
		values = {
			level    = "",
			trace_id = "",
			span_id  = "",
		}
	}

	forward_to = [loki.write.gateway.receiver]
}

// Defaults de reenvio do loki.write mantidos (FR-026).
loki.write "gateway" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"

		basic_auth {
			username = sys.env("LOKI_GATEWAY_USER")
			password = sys.env("LOKI_GATEWAY_PASSWORD")
		}
	}
}
