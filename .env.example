# -----------------------------------------------------------------------------
# Bootstrap global do monorepo
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jhonny_v
COMPOSE_PROFILES=core
TZ=UTC
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# URLs e portas locais
# -----------------------------------------------------------------------------
HOST_IP=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Serviço core: PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES_DB=jhonny_v
POSTGRES_USER=jhonny
POSTGRES_PASSWORD=change_me_postgres

# -----------------------------------------------------------------------------
# Serviço core: Redis
# -----------------------------------------------------------------------------
REDIS_APPENDONLY_MODE=yes

# -----------------------------------------------------------------------------
# Serviço core: RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=jhonny
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq
RABBITMQ_DEFAULT_VHOST=jhonny_v

# -----------------------------------------------------------------------------
# Observabilidade e integrações futuras (placeholders)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
# Porta do gateway autenticado do Loki (consulta e push).
LOKI_PORT=3100
LITELLM_PORT=4000

# -----------------------------------------------------------------------------
# Camada de observabilidade: Loki + Grafana Alloy (infra/compose.obs.yaml)
# -----------------------------------------------------------------------------
# Retenção dos logs no Loki (duração Prometheus: 72h, 7d, 2w...).
LOKI_RETENTION_PERIOD=7d
LOKI_LOG_LEVEL=info
# Rotação do driver json-file aplicada a todos os serviços das camadas.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
# Credenciais do gateway do Loki: obrigatório; segredo, não versionar.
LOKI_GATEWAY_USER=
LOKI_GATEWAY_PASSWORD=
# GID dono do socket do Docker: obrigatório; `stat -c %g /var/run/docker.sock`.
DOCKER_GID=

# -----------------------------------------------------------------------------
# LiteLLM Proxy (autenticação e provedores cloud opcionais)
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=
# Para validar sem iniciar o Ollama real, use o perfil validation e sobrescreva
# OLLAMA_API_BASE para http://ollama-local-mock:11435.
OLLAMA_API_BASE=http://ollama:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Com credenciais e sem sobrescrever as URLs, o proxy usa os endpoints oficiais.
OPENAI_API_BASE=http://litellm-cloud-unavailable:8080/v1
ANTHROPIC_API_BASE=http://litellm-cloud-unavailable:8080
