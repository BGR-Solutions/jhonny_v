# -----------------------------------------------------------------------------
# Bootstrap global do monorepo
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jhonny_v
COMPOSE_PROFILES=core
TZ=UTC
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# URLs e portas locais
# -----------------------------------------------------------------------------
HOST_IP=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Serviço core: PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES_DB=jhonny_v
POSTGRES_USER=jhonny
POSTGRES_PASSWORD=change_me_postgres

# -----------------------------------------------------------------------------
# Serviço core: Redis
# -----------------------------------------------------------------------------
REDIS_APPENDONLY_MODE=yes

# -----------------------------------------------------------------------------
# Serviço core: RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=jhonny
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq
RABBITMQ_DEFAULT_VHOST=jhonny_v

# -----------------------------------------------------------------------------
# Observabilidade e integrações futuras (placeholders)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100
LITELLM_PORT=4000

# -----------------------------------------------------------------------------
# LiteLLM Proxy (autenticação e provedores cloud opcionais)
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=
# Por padrão usa backend local mockado para validação de fluxo.
# Para usar Ollama real, sobrescreva para http://ollama:11434
OLLAMA_API_BASE=http://ollama-local-mock:11435
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE=http://litellm-cloud-unavailable:8080/v1
ANTHROPIC_API_BASE=http://litellm-cloud-unavailable:8080
